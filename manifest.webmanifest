  "description": "Семейная коллекция рецептов: ссылки разбирает домашний компьютер, рецепты хранятся на телефоне",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F4F0",
  "theme_color": "#2A44C9",
